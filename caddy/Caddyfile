{
    email you@example.com
    cert_issuer acme
}

# Kept inside route: denial must precede SPA rewrite.
(sandbox_public_guard) {
    @sandbox_private {
        path_regexp sandbox_private (^|/)(\.[^/]+|[^/]*\.(env|pem|key)|id_rsa[^/]*|id_ed25519[^/]*)(/|$)
        not path /.well-known/*
    }
    respond @sandbox_private 403
    @sandbox_wellknown_private path_regexp sandbox_wellknown_private ^/\.well-known/([^/]+/)*(\.[^/]+|[^/]*\.(env|pem|key)|id_rsa[^/]*|id_ed25519[^/]*)(/|$)
    respond @sandbox_wellknown_private 403
}

# Статические сайты и SPA-сборки (кейсы 1 и 2 без своего backend)
# лежат в /srv/sites/<app-name>/ и раздаются напрямую отсюда.
# Wildcard-сертификат требует DNS-01 — указываем его только здесь.
*.sandbox.example.com {
    tls {
        dns timeweb {env.TIMEWEB_API_TOKEN}
        # Четыре NS Timeweb синхронизируются медленно: с ожиданием по
        # умолчанию (2 минуты) Caddy бросал проверку раньше, чем TXT-запись
        # появлялась на всех серверах, и начинал заново с новым токеном.
        propagation_timeout 15m
    }

    # Пер-проектные SPA-правила. Генерируются деплой-хуком по ключу spa=
    # из .sandbox.conf и импортируются ВНУТРЬ этого блока: отдельный
    # site-блок на проект заставил бы Caddy выпускать по сертификату на
    # каждый поддомен вместо одного wildcard.
    #
    # Импорт стоит до общего handle — блоки handle взаимоисключающие и
    # проверяются в порядке записи, поэтому SPA-проекты перехватываются
    # своими правилами, а все остальные попадают в обычный file_server.
    import /srv/caddy/spa.d/*.caddy

    # Регулярное выражение совпадает с правилом валидации имён проектов
    # (deploy/lib/common.sh): дефис не может быть первым или последним.
    @app header_regexp app Host ^([a-z0-9]([a-z0-9-]*[a-z0-9])?)\.sandbox\.example\.com$
    handle @app {
        # Раздаётся ссылка current, а не сам каталог проекта: она
        # переключается атомарно после успешной сборки.
        root * /srv/sites/{re.app.1}/current
        route {
            import sandbox_public_guard
            file_server
        }
    }

    handle {
        respond "Unknown sandbox project" 404
    }
}

# Голый apex-домен — не wildcard, поэтому спокойно проходит через
# обычный HTTP-01 challenge, DNS-провайдер ему не нужен.
sandbox.example.com {
    respond "Sandbox root — see project subdomains"
}

# Docker-контейнеры с лейблами caddy:/caddy.reverse_proxy: тоже получают
# сертификаты через HTTP-01 автоматически — это конкретные FQDN, не wildcard,
# так что caddy-docker-proxy не требует никакой доп. настройки DNS.
